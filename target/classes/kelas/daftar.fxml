<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="639.0" prefWidth="752.0" style="-fx-background-color: white;" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
   <center>
      <VBox prefHeight="639.0" prefWidth="752.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <!-- Header Atas: Tombol Kembali & Judul Halaman -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button fx:id="btnKembali" mnemonicParsing="false" onAction="#handleKembali" prefHeight="36.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-background-radius: 6; -fx-border-radius: 6; -fx-text-fill: #374151; -fx-cursor: hand;" text="← Kembali">
                     <font>
                        <Font name="Segoe UI Bold" size="14.0" />
                     </font>
                  </Button>
                  <Label text="Daftar Produk">
                     <font>
                        <Font name="Segoe UI Bold" size="25.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </HBox>

            <!-- Input Pencarian -->
            <TextField fx:id="cariField" prefHeight="42.0" promptText="Cari Kode atau Nama Produk..." style="-fx-background-radius: 8; -fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-padding: 8 12; -fx-border-width: 1; -fx-border-radius: 8;">
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
               <font>
                  <Font name="Segoe UI" size="15.0" />
               </font>
            </TextField>

            <!-- Dropdown Filter Kategori -->
            <ComboBox fx:id="kategoriCombo" onAction="#handleFilterKategori" prefHeight="40.0" prefWidth="180.0" promptText="Pilih Kategori" style="-fx-background-radius: 8; -fx-font-family: 'Segoe UI'; -fx-font-size: 15px;">
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
            </ComboBox>

            <!-- Baris Tombol Aksi & Toggle -->
            <FlowPane hgap="10.0" prefWidth="712.0" vgap="10.0">
               <children>
                  <Button fx:id="btnCari" mnemonicParsing="false" onAction="#handleCari" prefHeight="36.0" prefWidth="75.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-background-radius: 6; -fx-border-radius: 6; -fx-text-fill: #374151; -fx-cursor: hand;" text="Cari">
                     <font>
                        <Font name="Segoe UI" size="15.0" />
                     </font>
                  </Button>

                  <Button fx:id="btnReset" mnemonicParsing="false" onAction="#handleReset" prefHeight="36.0" prefWidth="75.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-background-radius: 6; -fx-border-radius: 6; -fx-text-fill: #374151; -fx-cursor: hand;" text="Reset">
                     <font>
                        <Font name="Segoe UI" size="15.0" />
                     </font>
                  </Button>

                  <Button fx:id="btnTambah" mnemonicParsing="false" onAction="#handleTambah" prefHeight="36.0" prefWidth="95.0" style="-fx-background-color: #2563eb; -fx-background-radius: 6; -fx-text-fill: white; -fx-cursor: hand;" text="Tambah">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Button>

                  <Button fx:id="btnDetail" mnemonicParsing="false" onAction="#handleDetail" prefHeight="36.0" prefWidth="110.0" style="-fx-background-color: #FFB366; -fx-border-color: #d1d5db; -fx-background-radius: 6; -fx-border-radius: 6; -fx-text-fill: #374151; -fx-cursor: hand;" text="Lihat Detail">
                     <font>
                        <Font name="Segoe UI" size="15.0" />
                     </font>
                  </Button>

                  <Button fx:id="btnHapus" mnemonicParsing="false" onAction="#handleHapus" prefHeight="36.0" prefWidth="80.0" style="-fx-background-color: #dc2626; -fx-background-radius: 6; -fx-text-fill: white; -fx-cursor: hand;" text="Hapus">
                     <font>
                        <Font name="Segoe UI Bold" size="15.0" />
                     </font>
                  </Button>

                  <CheckBox fx:id="chkTotal" mnemonicParsing="false" onAction="#handleToggleTotal" selected="true" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px;" text="Total">
                     <FlowPane.margin>
                        <Insets left="10.0" />
                     </FlowPane.margin>
                  </CheckBox>

                  <CheckBox fx:id="chkJumlah" mnemonicParsing="false" onAction="#handleToggleJumlah" selected="true" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 15px;" text="Jumlah" />
               </children>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" top="5.0" />
               </VBox.margin>
            </FlowPane>

            <!-- TableView Produk Modern -->
            <TableView fx:id="produkTable" prefHeight="400.0" prefWidth="712.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="kodeCol" prefWidth="80.0" text="Kode" />
                  <TableColumn fx:id="namaCol" prefWidth="150.0" text="Nama Produk" />
                  <TableColumn fx:id="kategoriCol" prefWidth="100.0" text="Kategori" />
                  <TableColumn fx:id="hargaCol" prefWidth="110.0" text="Harga (Rp)" />
                  <TableColumn fx:id="jumlahCol" prefWidth="80.0" text="Jumlah" />
                  <TableColumn fx:id="gambarCol" prefWidth="100.0" text="Foto Produk" />
               </columns>
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
               </VBox.margin>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
